<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F11"
    tools:context=".ui.ProfileSetupActivity">

    <!-- Premium Custom Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_profile_setup"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#16161A"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Go Back" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/btn_back"
            android:text="Profile Setup"
            android:textColor="#F5F5F7"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_profile_setup"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plenxo Identity"
                android:textColor="#8B5CF6"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set up your premium chat profile"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"/>

            <!-- Profile Picture Section -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp">

                <!-- Inner Ring Glow (Neon Cyan Glow) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    app:cardCornerRadius="72dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00E5FF"
                    android:layout_gravity="center">

                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        app:cardCornerRadius="70dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#16161A"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/img_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_foreground"
                            android:contentDescription="Profile Picture" />

                    </androidx.cardview.widget.CardView>

                </androidx.cardview.widget.CardView>

                <!-- Floating Edit/Upload Pencil Icon Overlay -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_edit_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#8B5CF6"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="#FFFFFF"
                        android:contentDescription="Upload profile picture" />

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- Input Fields Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Name"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_edittext_dark"
                    android:hint="Enter display name"
                    android:textColorHint="#4B5563"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status / About"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_about"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_edittext_dark"
                    android:hint="Hey there! I am using Plenxo."
                    android:textColorHint="#4B5563"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:importantForAutofill="no"/>

            </LinearLayout>

            <!-- Save / Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Profile Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#8B5CF6"
                app:rippleColor="#00E5FF"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Progress Overlay (Initially Gone) -->
    <RelativeLayout
        android:id="@+id/progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0B0E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminate="true"
                android:indeterminateTint="#00E5FF"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_progress_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploading to ImgBB..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
